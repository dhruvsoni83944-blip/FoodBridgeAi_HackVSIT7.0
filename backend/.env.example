# ==============================================================================
# FoodBridge AI — Backend Server Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Public URL of this Backend API (e.g. https://api.yourdomain.com)
APP_URL="https://api.yourdomain.com"

# CORS Origin: Allowed frontend domains (comma-separated if multiple)
# In production, specify your frontend deployment domain(s)
CORS_ORIGIN="https://foodbridge-ai.vercel.app,http://localhost:5173"

# ==============================================================================
# Managed PostgreSQL Database Connection (Prisma)
# ==============================================================================
# Works with any managed PostgreSQL provider (Neon, Supabase, Render, Railway, AWS RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodbridge_db?schema=public"

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate a cryptographically strong 32+ character secret in bash: openssl rand -base64 32
JWT_SECRET="replace_with_strong_random_jwt_secret_in_production_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# Google Gemini Vision API (Server-side food inspection)
# ==============================================================================
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-google-gemini-api-key-here"
# Default cost-effective high-speed vision model:
GEMINI_MODEL="gemini-flash-lite-latest"

# ==============================================================================
# Cloudinary Storage (Persistent Cloud Media for Food Donation Photos)
# ==============================================================================
# Required in production so images persist across stateless container deployments
# Get credentials from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==============================================================================
# Python FastAPI AI Microservice (OPTIONAL)
# ==============================================================================
# If deployed as a secondary microservice, enter its URL here.
# If omitted, the Node.js backend automatically runs its built-in heuristic fallback.
AI_SERVICE_URL=""

# ==============================================================================
# Third-party Maps & Routing (Optional)
# ==============================================================================
# By default, FoodBridge AI uses the mathematical Haversine formula for distance.
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
